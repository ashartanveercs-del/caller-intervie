{
  "name": "ghost-ai",
  "version": "1.0.0",
  "description": "AI Interview Assistant",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "set NODE_ENV=development && electron .",
    "build:win": "electron-builder --win portable --x64"
  },
  "build": {
    "appId": "com.ghostai.app",
    "productName": "GhostAI",
    "artifactName": "GhostAI.exe",
    "win": {
      "target": "portable",
      "icon": "assets/icon.ico"
    },
    "portable": {
      "artifactName": "GhostAI.exe"
    },
    "files": [
      "src/**/*",
      "assets/**/*"
    ]
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "groq-sdk": "^0.15.0",
    "marked": "^15.0.0",
    "ws": "^8.18.0"
  }
}
